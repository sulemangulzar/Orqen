# Application
APP_NAME=Orqen
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orqen

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Email (optional for local development)
RESEND_API_KEY=
EMAIL_FROM=Orqen <noreply@example.com>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Shopify OAuth
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/shopify/callback
SHOPIFY_API_VERSION=2026-01
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# OpenAI — add your key here locally; never commit it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
AI_MAX_TOKENS=800
PINECONE_API_KEY=
PINECONE_COLLECTION=
DOCUMENT_STORAGE_PATH=./storage/documents
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
AI_MAX_TOKENS=800

# Pinecone vector storage
PINECONE_API_KEY=
PINECONE_COLLECTION=

# Optional local vector storage tuning
PGVECTOR_COLLECTION=orqen_documents
